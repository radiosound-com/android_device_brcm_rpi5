<!--
     Caramel Voice is the product's on-device PTT recognizer. Keep this as a
     normal (user-controllable) dangerous-permission grant rather than a
     privileged-permission allowlist entry: it gives the preinstalled
     assistant microphone access on first boot while preserving Android's
     permission model for later user changes.
-->
<exceptions>
    <exception package="com.radiosound.caramelvoice">
        <permission name="android.permission.RECORD_AUDIO" fixed="false"/>
    </exception>
</exceptions>
