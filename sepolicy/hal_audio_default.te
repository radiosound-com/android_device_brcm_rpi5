get_prop(hal_audio_default, vendor_audio_config_prop)

allow hal_audio_default i2c_device:chr_file { getattr open read write ioctl };
set_prop(hal_audio_default, vendor_a2b_prop)
allow hal_audio_default vendor_a2b_data_file:dir r_dir_perms;
allow hal_audio_default vendor_a2b_data_file:file r_file_perms;
allow hal_audio_default vendor_a2b_socket:sock_file { getattr read write };
